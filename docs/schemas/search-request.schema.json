{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cloudflare Web Search REST request (extracted documentation)",
  "type": "object",
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "provider": {
      "type": "string",
      "enum": [
        "ceramic",
        "exa",
        "linkup"
      ],
      "default": "ceramic"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "default": 10
    },
    "byokAlias": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "options": {
      "type": "object",
      "properties": {
        "gateway": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            }
          },
          "required": [
            "id"
          ]
        }
      },
      "required": [
        "gateway"
      ]
    }
  },
  "required": [
    "query",
    "options"
  ]
}
